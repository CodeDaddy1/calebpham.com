# calebpham.com has no secrets and needs no environment variables.
# NEXT_PUBLIC_SITE_URL is optional: src/lib/site.ts falls back to the apex
# (https://calebpham.com) and, on Vercel previews, to VERCEL_PROJECT_PRODUCTION_URL.
# NEXT_PUBLIC_SITE_URL=

# Demo capture (scripts/capture-demo.mjs): the City Storage demo persona on lumaiq.dev.
# LUMAIQ_DEMO_EMAIL=
# LUMAIQ_DEMO_PASSWORD=

# Banner photos (scripts/fetch-banners.mjs): pulled from the Vercel project with `vercel env pull`, used once, never at build or run time.
# PEXELS_KEY=
